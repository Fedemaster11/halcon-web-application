<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Halcon"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_Halcon">
    <bpmn:participant id="Participant_Halcon" name="Halcon Order Management Process" processRef="Process_Halcon"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Halcon" name="Halcon Order Management Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Halcon">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales">
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetOrdered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetInProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MaterialsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetInRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoadVehicle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Purchasing" name="Purchasing">
        <bpmn:flowNodeRef>Task_BuyMissingMaterials</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Route" name="Route">
        <bpmn:flowNodeRef>Task_UploadLoadingPhoto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDeliveryPhoto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Order" name="Order requested"/>
    <bpmn:task id="Task_PlaceOrder" name="Place order"/>
    <bpmn:task id="Task_CreateOrder" name="Create order"/>
    <bpmn:task id="Task_SetOrdered" name="Set status: Ordered"/>
    <bpmn:task id="Task_ReviewOrder" name="Review order"/>
    <bpmn:task id="Task_SetInProcess" name="Set status: In process"/>
    <bpmn:task id="Task_CheckMaterials" name="Check materials"/>
    <bpmn:exclusiveGateway id="Gateway_MaterialsAvailable" name="Materials available?"/>
    <bpmn:task id="Task_BuyMissingMaterials" name="Buy missing materials"/>
    <bpmn:task id="Task_ReceiveMaterials" name="Receive materials"/>
    <bpmn:exclusiveGateway id="Gateway_MergeMaterials"/>
    <bpmn:task id="Task_PrepareOrder" name="Prepare order"/>
    <bpmn:task id="Task_SetInRoute" name="Set status: In route"/>
    <bpmn:task id="Task_LoadVehicle" name="Load delivery vehicle"/>
    <bpmn:task id="Task_UploadLoadingPhoto" name="Upload loading photo"/>
    <bpmn:task id="Task_DeliverOrder" name="Deliver order"/>
    <bpmn:task id="Task_UploadDeliveryPhoto" name="Upload delivery photo"/>
    <bpmn:task id="Task_SetDelivered" name="Set status: Delivered"/>
    <bpmn:task id="Task_CheckStatus" name="Check order status"/>
    <bpmn:endEvent id="EndEvent_Order" name="Order completed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Order" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PlaceOrder" targetRef="Task_CreateOrder"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CreateOrder" targetRef="Task_SetOrdered"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SetOrdered" targetRef="Task_ReviewOrder"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ReviewOrder" targetRef="Task_SetInProcess"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SetInProcess" targetRef="Task_CheckMaterials"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckMaterials" targetRef="Gateway_MaterialsAvailable"/>
    <bpmn:sequenceFlow id="Flow_08_Yes" name="Yes" sourceRef="Gateway_MaterialsAvailable" targetRef="Gateway_MergeMaterials"/>
    <bpmn:sequenceFlow id="Flow_08_No" name="No" sourceRef="Gateway_MaterialsAvailable" targetRef="Task_BuyMissingMaterials"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_BuyMissingMaterials" targetRef="Task_ReceiveMaterials"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReceiveMaterials" targetRef="Gateway_MergeMaterials"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_MergeMaterials" targetRef="Task_PrepareOrder"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PrepareOrder" targetRef="Task_SetInRoute"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SetInRoute" targetRef="Task_LoadVehicle"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LoadVehicle" targetRef="Task_UploadLoadingPhoto"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_UploadLoadingPhoto" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DeliverOrder" targetRef="Task_UploadDeliveryPhoto"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_UploadDeliveryPhoto" targetRef="Task_SetDelivered"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SetDelivered" targetRef="Task_CheckStatus"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CheckStatus" targetRef="EndEvent_Order"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Halcon">
    <bpmndi:BPMNPlane id="BPMNPlane_Halcon" bpmnElement="Collaboration_Halcon">
      <bpmndi:BPMNShape id="Participant_Halcon_di" bpmnElement="Participant_Halcon" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="2880" height="750"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="2850" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sales_di" bpmnElement="Lane_Sales" isHorizontal="true">
        <dc:Bounds x="30" y="150" width="2850" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse" isHorizontal="true">
        <dc:Bounds x="30" y="300" width="2850" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Purchasing_di" bpmnElement="Lane_Purchasing" isHorizontal="true">
        <dc:Bounds x="30" y="450" width="2850" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Route_di" bpmnElement="Lane_Route" isHorizontal="true">
        <dc:Bounds x="30" y="600" width="2850" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Order_di" bpmnElement="StartEvent_Order">
        <dc:Bounds x="80" y="57" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PlaceOrder_di" bpmnElement="Task_PlaceOrder">
        <dc:Bounds x="150" y="35" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateOrder_di" bpmnElement="Task_CreateOrder">
        <dc:Bounds x="310" y="185" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetOrdered_di" bpmnElement="Task_SetOrdered">
        <dc:Bounds x="460" y="185" width="125" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewOrder_di" bpmnElement="Task_ReviewOrder">
        <dc:Bounds x="630" y="335" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetInProcess_di" bpmnElement="Task_SetInProcess">
        <dc:Bounds x="780" y="335" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckMaterials_di" bpmnElement="Task_CheckMaterials">
        <dc:Bounds x="955" y="335" width="115" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MaterialsAvailable_di" bpmnElement="Gateway_MaterialsAvailable" isMarkerVisible="true">
        <dc:Bounds x="1110" y="350" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuyMissingMaterials_di" bpmnElement="Task_BuyMissingMaterials">
        <dc:Bounds x="1210" y="485" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveMaterials_di" bpmnElement="Task_ReceiveMaterials">
        <dc:Bounds x="1390" y="335" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeMaterials_di" bpmnElement="Gateway_MergeMaterials" isMarkerVisible="true">
        <dc:Bounds x="1550" y="350" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareOrder_di" bpmnElement="Task_PrepareOrder">
        <dc:Bounds x="1640" y="335" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetInRoute_di" bpmnElement="Task_SetInRoute">
        <dc:Bounds x="1790" y="335" width="125" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadVehicle_di" bpmnElement="Task_LoadVehicle">
        <dc:Bounds x="1955" y="335" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UploadLoadingPhoto_di" bpmnElement="Task_UploadLoadingPhoto">
        <dc:Bounds x="2130" y="635" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliverOrder_di" bpmnElement="Task_DeliverOrder">
        <dc:Bounds x="2310" y="635" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UploadDeliveryPhoto_di" bpmnElement="Task_UploadDeliveryPhoto">
        <dc:Bounds x="2460" y="635" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetDelivered_di" bpmnElement="Task_SetDelivered">
        <dc:Bounds x="2640" y="635" width="125" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckStatus_di" bpmnElement="Task_CheckStatus">
        <dc:Bounds x="2640" y="35" width="125" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Order_di" bpmnElement="EndEvent_Order">
        <dc:Bounds x="2800" y="57" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="116" y="75"/><di:waypoint x="150" y="75"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="260" y="75"/><di:waypoint x="285" y="75"/><di:waypoint x="285" y="225"/><di:waypoint x="310" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="420" y="225"/><di:waypoint x="460" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="585" y="225"/><di:waypoint x="607" y="225"/><di:waypoint x="607" y="375"/><di:waypoint x="630" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="740" y="375"/><di:waypoint x="780" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="915" y="375"/><di:waypoint x="955" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1070" y="375"/><di:waypoint x="1110" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_Yes_di" bpmnElement="Flow_08_Yes"><di:waypoint x="1160" y="375"/><di:waypoint x="1550" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_No_di" bpmnElement="Flow_08_No"><di:waypoint x="1135" y="400"/><di:waypoint x="1135" y="525"/><di:waypoint x="1210" y="525"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1350" y="525"/><di:waypoint x="1370" y="525"/><di:waypoint x="1370" y="375"/><di:waypoint x="1390" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1510" y="375"/><di:waypoint x="1550" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1600" y="375"/><di:waypoint x="1640" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1750" y="375"/><di:waypoint x="1790" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1915" y="375"/><di:waypoint x="1955" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="2085" y="375"/><di:waypoint x="2105" y="375"/><di:waypoint x="2105" y="675"/><di:waypoint x="2130" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="2270" y="675"/><di:waypoint x="2310" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="2420" y="675"/><di:waypoint x="2460" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="2600" y="675"/><di:waypoint x="2640" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="2702" y="635"/><di:waypoint x="2702" y="115"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="2765" y="75"/><di:waypoint x="2800" y="75"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
